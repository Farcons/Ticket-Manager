@page "/editar"
@inject IRepCaso repCaso
@inject NavigationManager Nav
@inject IJSRuntime JS

@using TicketManager.Data
@using TicketManager.Data.Casos
@using TicketManager.Data.Enums

<h3>Editar Caso</h3>

@if (caso == null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <div class="card p-3" style="max-width:700px;">
        <div class="form-group">
            <label>Número</label>
            <input class="form-control" @bind="caso.Numero" type="number" />
        </div>

        <!-- Cliente -->
        <div class="form-group mt-2">
            <label>Cliente *</label>
            <SelectCliente @bind-Value="caso.CodigoCliente" IsInvalid="erroCliente" />
        </div>

        <div class="form-group mt-2">
            <label>Módulo</label>
            <select class="form-control" @bind="caso.Modulo">
                @foreach (var m in modulosFiltrados)
                {
                    <option value="@m">@m.GetFriendlyModuleName()</option>
                }
            </select>
        </div>

        <div class="form-group mt-2">
            <label>Problema</label>
            <textarea class="form-control" @bind="caso.Problema"></textarea>
        </div>

        <div class="form-group mt-2">
            <label>Solução</label>
            <textarea class="form-control" @bind="caso.Solucao"></textarea>
        </div>

        <!-- Tempo Decorrido -->
        <div class="form-group mt-2">
            <label>Tempo Decorrido (HH:MM)</label>
            <input class="form-control" @bind="tempoTexto" type="text" placeholder="00:00" pattern="\d{2}:\d{2}" />
        </div>

        <div class="mt-3">
            <button class="btn btn-primary me-2" @onclick="Salvar">Salvar (Ctrl+Enter)</button>
            <button class="btn btn-danger" @onclick="ConfirmExcluir">Excluir</button>
            <button class="btn btn-dark" @onclick="Voltar">Voltar</button>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] public string id { get; set; }

    Caso? caso;
    List<EnumModulos> modulosFiltrados = new();
    bool erroNumero, erroCliente, erroSistema, erroModulo;
    string? mensagem;

    string tempoTexto
    {
        get => caso?.TempoDecorrido ?? "00:00";
        set { if (caso != null) caso.TempoDecorrido = value; }
    }

    private EnumSistema selectedSistema
    {
        get => caso?.Sistema ?? EnumSistema.M2;
        set
        {
            if (caso != null)
            {
                caso.Sistema = value;
                AtualizarModulos();
                caso.Modulo = modulosFiltrados.FirstOrDefault();
            }
        }
    }

    protected override void OnInitialized()
    {
        caso = repCaso.Find(Guid.Parse(id));
        if (caso == null) return;
        AtualizarModulos();
        JS.InvokeVoidAsync("ticketManager.registerSaveShortcut", DotNetObjectReference.Create(this));
    }

    private void AtualizarModulos()
    {
        if (caso == null) { modulosFiltrados = new(); return; }
        modulosFiltrados = caso.Sistema switch
        {
            EnumSistema.M2 => Enum.GetValues<EnumModulos>().Cast<EnumModulos>().Where(m => ((int)m >= 1000 && (int)m < 2000)).ToList(),
            EnumSistema.CRM => Enum.GetValues<EnumModulos>().Cast<EnumModulos>().Where(m => ((int)m >= 2000 && (int)m < 3000)).ToList(),
            EnumSistema.PCP => Enum.GetValues<EnumModulos>().Cast<EnumModulos>().Where(m => ((int)m >= 3000 && (int)m < 4000)).ToList(),
            _ => new()
        };
    }

    void Salvar()
    {
        erroNumero = erroCliente = erroSistema = erroModulo = false;
        bool invalido = false;

        if (caso.Numero == 0)
        {
            erroNumero = true;
            invalido = true;
        }
        else if (repCaso.NumeroExiste(caso.Id, caso.Numero))
        {
            erroNumero = true;
            invalido = true;
        }

        if (caso.CodigoCliente == Guid.Empty)
        {
            erroCliente = true;
            invalido = true;
        }

        if (!Enum.IsDefined(typeof(EnumSistema), caso.Sistema))
        {
            erroSistema = true;
            invalido = true;
        }

        if (!Enum.IsDefined(typeof(EnumModulos), caso.Modulo))
        {
            erroModulo = true;
            invalido = true;
        }

        if (invalido)
        {
            mensagem = "Preencha todos os campos obrigatórios corretamente.";
            return;
        }

        repCaso.PersistirTransacao();
        mensagem = "Ticket salvo com sucesso!";
        Nav.NavigateTo("/consulta");
    }

    [JSInvokable]
    public void OnShortcutSave()
    {
        Salvar();
    }

    async Task ConfirmExcluir()
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Confirmar exclusão do ticket #{caso?.Id}?")) return;
        if (caso != null) repCaso.Excluir(caso.Id);
        Nav.NavigateTo("/consulta");
    }

    private void Voltar()
    {
        Nav.NavigateTo("/consulta");
    }
}
